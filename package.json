    "README.md",
    "README_zh.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test",
    "build": "bun run scripts/build.ts",
    "prepublishOnly": "bun run build && bun test"
  },
  "keywords": [
    "bazi",
    "mcp",

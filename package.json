  "license": "MIT",
  "homepage": "https://github.com/listen-hai/bazi-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/listen-hai/bazi-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/listen-hai/bazi-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.0",
    "@openfate/bazi-engine": "^1.1.2",
    "@openfate/true-solar-time": "^4.0.0",
    "@photostructure/tz-lookup": "^11.6.1",
